{
  "name": "youtube-playlist-manager",
  "private": true,
  "scripts": {
    "dev": "docker compose up -d db & concurrently -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun run --cwd packages/server dev",
    "migrate": "bun run --cwd packages/server migrate",
    "dev:web": "bun run --cwd packages/web dev",
    "lint": "biome ci .",
    "test": "bun run test:server && bun run test:web",
    "test:server": "bun test --cwd packages/server",
    "test:web": "bun test --cwd packages/web"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "latest",
    "concurrently": "^9.2.1"
  }
}
